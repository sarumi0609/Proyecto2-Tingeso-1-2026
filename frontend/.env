# URL del API Gateway — en producción usa la IP de minikube + NodePort 30080
# En desarrollo, vite proxy redirige /api a localhost:8080
VITE_GATEWAY_URL=http://localhost:8080

# URL de Keycloak — en producción usa la IP de minikube + NodePort 30090
VITE_KEYCLOAK_URL=http://localhost:8090
VITE_KEYCLOAK_REALM=travelagency
VITE_KEYCLOAK_CLIENT_ID=travelagency-frontend
